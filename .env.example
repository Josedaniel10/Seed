# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase: Project credentials for persistent PostgreSQL database & authentication
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Selector temporal: Ctrl + Shift + . (activo por defecto solo en desarrollo).
# false lo desactiva también en desarrollo; true lo habilita en el build.
# VITE_PRESENTATION_MODE="false"
# Contraseña prellenada solo en el modal temporal (se incluye en el cliente si se configura).
# VITE_PRESENTATION_PASSWORD=""

# Solo para administrar migraciones desde herramientas locales; nunca usar VITE_DATABASE_URL.
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@SESSION_POOLER_HOST:5432/postgres"
